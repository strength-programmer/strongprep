# Copy to .env and edit. Demo mode needs NO API keys.
APP_MODE=demo
DATABASE_URL=sqlite:///./strongprep-demo.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI: "mock" (default demo), "claude", or "openai_compatible" (e.g. Qwen via DashScope)
AI_PROVIDER=mock
# openai_compatible only. The key is sent ONLY to LLM_BASE_URL. Example base URL form: https://<host>/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ANTHROPIC_API_KEY=
# Set to a current model id from the Claude API docs (not hard-coded in the app)
CLAUDE_MODEL=

# Encrypts API keys entered in the app (Settings page). Demo auto-creates .strongprep-secret; live REQUIRES this.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# Later milestones (optional; absent keys never break manual entry)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Live mode only (APP_MODE=live): Supabase Postgres + Auth
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=
# Verification: set the project's JWT secret (HS256 projects) OR leave empty to use the project's JWKS endpoint
SUPABASE_JWT_SECRET=

